    {
        "id": "a1fbb2c8ee1f7b34",
        "type": "ui_template",
        "z": "tab1",
        "d": true,
        "group": "ui_group1",
        "name": "播放直播",
        "order": 11,
        "width": 4,
        "height": 3,
        "format": "<video id=\"videoElement\" autoplay muted playsinline></video>\n\n<script src=\"https://cdn.jsdelivr.net/npm/hls.js@latest\"></script>\n<script>\n    (function(){\n    var video = document.getElementById('videoElement');\n    var hlsInstance;\n\n    function reloadHLS() {\n        console.log(\"嘗試載入影片\");  // 普通 debug\n        if (typeof Hls === \"undefined\") {\n            console.error(\"Hls.js 尚未載入!\");\n            return;\n        }\n\n        if(hlsInstance) hlsInstance.destroy();\n        hlsInstance = new Hls();\n        hlsInstance.loadSource('/output.m3u8');  \n        hlsInstance.attachMedia(video);\n\n        hlsInstance.on(Hls.Events.MANIFEST_PARSED, function(){\n            console.log(\"HLS 已解析 manifest\");\n            video.play();\n        });\n\n        hlsInstance.on(Hls.Events.ERROR, function(event, data){\n            console.error(\"HLS 前端播放錯誤:\", data);\n        });\n    }\n\n    // 首次播放\n    setTimeout(reloadHLS, 100);\n\n    // 防止使用者暫停\n    video.addEventListener('pause', function(){ video.play(); });\n\n    // 點擊影片就重新載入，延遲 1 秒\n    video.addEventListener('click', function(){\n        console.log(\"1秒後嘗試重新載入影片\");\n        setTimeout(reloadHLS, 1000);\n    });\n})();\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 1340,
        "y": 1580,
