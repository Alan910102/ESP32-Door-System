        "format": "<div style=\"position: relative; width: 100%; max-width: 640px; margin: auto;\">\n    <!-- 影片容器 -->\n    <div id=\"streamContainer\">\n        <img id=\"liveStream\" src=\"\" style=\"width:100%; display:block;\">\n    </div>\n\n    <!-- 覆蓋提示 -->\n    <div id=\"overlay\" style=\"\n      position: absolute;\n      top: 0; left: 0; right: 0; bottom: 0;\n      background: rgba(128,128,128,0.7); /* 灰底，半透明 */\n      color: white; /* 白字 */\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      font-size: 20px;\n      cursor: pointer;\n      text-align: center;\n      text-shadow: 1px 1px 2px #000; /* 增加可讀性 */\n  \">\n        點擊開始觀看直播\n    </div>\n</div>\n\n<script>\n    document.getElementById(\"overlay\").addEventListener(\"click\", function() {\n  // 開始串流\n  document.getElementById(\"liveStream\").src = \"http://<YOUR_DDNS_DOMAIN>/stream\";\n  // 隱藏提示\n  this.style.display = \"none\";\n});\n</script>",
